# 마케팅 Supabase (web 과 다른 프로젝트). 클라우드 프로젝트 하나만 쓴다 — console 과 같은 값.
SUPABASE_URL=https://<project>.supabase.co
# Settings → API Keys 의 Secret key (sb_secret_…). 서버 전용 — 예전 service_role 키도 된다
SUPABASE_SECRET_KEY=

# mock = ffmpeg 로 가짜 이미지·영상을 만든다(비용 0). live = 실제 AI 업체 호출.
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4_turbo

# 목소리 업체 (core/src/ai/voice). 녹음 목소리는 모델마다 화면에서 qwen / elevenlabs 를 고른다.
# VOICE_PROVIDER = 모델에 엔진이 없을 때(예전 모델) 쓸 곳, VOICE_PRESET_PROVIDER = 기본 목소리("맑은 여성" 등)를 읽을 곳
VOICE_PROVIDER=elevenlabs
# VOICE_PRESET_PROVIDER=elevenlabs

# Qwen3-TTS 자체 음성 서버 (apps/marketing/voice-server). 무료(Apache-2.0). GPU 서버 또는 Apple Silicon 맥
# 맥에서 띄우면 QWEN_TTS_URL=http://localhost:8000 (토큰은 비워도 된다). 목소리 보관함의 후보 만들기도 이 서버가 한다
QWEN_TTS_URL=
QWEN_TTS_TOKEN=
# 목소리 설명 중 직접 적은 한국어를 영어로 옮길 때 (OPENAI_API_KEY 가 있을 때만. 없으면 원문 그대로)
# OPENAI_TEXT_MODEL=gpt-4o-mini
# 목소리 (ElevenLabs) — 녹음 목소리 등록(보이스 클로닝)과 숏폼 내레이션. 녹음 목소리 등록은 유료 요금제(Starter 이상)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# 기본 목소리 이름 → ElevenLabs voice_id 직접 지정 (비우면 업체 기본 목소리 중 성별·설명으로 자동 선택)
# ELEVENLABS_PRESET_VOICES={"맑은 여성":"voice_id","중저음 남성":"voice_id"}

# mock = 실제로 올리지 않고 가짜 게시물 주소를 돌려준다. live = 플랫폼 API 로 올린다.
PUBLISH_MODE=mock
# 유튜브 토큰 갱신용 (live) — console 과 같은 OAuth 클라이언트 값
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 작업을 확인하는 간격(ms)
POLL_MS=2000
