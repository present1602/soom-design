# 마케팅 Supabase (web 과 다른 프로젝트). 클라우드 프로젝트 하나만 쓴다 — worker 와 같은 값.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# Settings → API Keys. Publishable key(sb_publishable_…)는 브라우저용, Secret key(sb_secret_…)는 서버 전용.
# 예전 이름(NEXT_PUBLIC_SUPABASE_ANON_KEY · SUPABASE_SERVICE_ROLE_KEY)도 읽는다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 처음 로그인하면 슈퍼어드민이 되는 이메일(쉼표로 구분). 그 뒤로는 담당자 관리 화면에서 사람을 넣는다.
SUPER_ADMIN_EMAILS=

# ───── 채널 연결 (고객이 연결 링크에서 직접 로그인·허용) ─────
# 콘솔 바깥 주소. 비우면 요청 주소를 쓴다. 인스타그램은 https 리디렉션 주소만 받으므로 로컬에서는
# `cloudflared tunnel --url http://localhost:3100` 로 받은 https 주소를 넣는다.
# 플랫폼 앱 설정에 등록할 리디렉션 주소: <CONSOLE_URL>/api/oauth/callback/instagram · <CONSOLE_URL>/api/oauth/callback/youtube
CONSOLE_URL=
# 연결 링크 서명용 비밀값(아무 긴 무작위 문자열). 비우면 SUPABASE_SECRET_KEY 로 서명한다
OAUTH_STATE_SECRET=
# 인스타그램: Meta 앱 > Instagram > API setup with Instagram login 의 "Instagram 앱 ID·시크릿" (Meta 앱 ID 가 아니다)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 유튜브: Google Cloud > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트(웹 애플리케이션). YouTube Data API v3 사용 설정
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
