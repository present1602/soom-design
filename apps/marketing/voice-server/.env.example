# 음성 서버 설정 — .env.local 로 복사해서 쓴다 (run.sh 가 읽는다)

# 읽기 모델. 맥 메모리가 빠듯하면 0.6B, 품질을 높이려면 1.7B (기본)
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# 목소리 만들기(보관함 후보) 모델
# QWEN_TTS_DESIGN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign

# 비우면 자동 (cuda → mps → cpu)
# DEVICE=mps

# 워커 .env.local 의 QWEN_TTS_TOKEN 과 같게. 내 맥에서만 쓰면 비워도 된다
VOICE_SERVER_TOKEN=

# VOICE_HOST=127.0.0.1
# VOICE_PORT=8000
