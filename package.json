{
  "name": "balance",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "dev:marketing": "pnpm --parallel --filter @marketing/console --filter @marketing/worker dev",
    "dev:console": "pnpm --filter @marketing/console dev",
    "dev:worker": "pnpm --filter @marketing/worker dev"
  }
}
